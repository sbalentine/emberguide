<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover"
  >
  <meta name="theme-color" content="#080711">
  <link
    rel="stylesheet"
    href="/dashboard.css?v=<%= File.mtime(File.join(APP_ROOT, "public", "dashboard.css")).to_i %>"
  >
  <title>Achievements</title>
</head>

<body>
  <main class="container settings-page achievements-page">
    <%
      navigation_active = "achievements"
      missing_count = Array(achievement_data["missing"]).length
    %>
    <%= render_partial("navigation", binding) %>

    <header class="settings-header achievements-header">
      <div>
        <h1>Achievements</h1>
        <div class="subtitle">
          Celebrate the habits and progress behind the grades.
        </div>
      </div>
      <a href="/settings/achievements">Customize achievements</a>
    </header>

    <section class="achievement-grid" aria-label="Current achievement streaks">
      <article class="card achievement-card achievement-card-on-time">
        <div class="achievement-card-topline">
          <span class="achievement-icon" aria-hidden="true">🔥</span>
          <span class="achievement-label">Current streak</span>
        </div>
        <div class="achievement-value">
          <strong><%= achievement_streaks["on_time"] %></strong>
          <span><%= achievement_streaks["on_time"] == 1 ? "assignment" : "assignments" %></span>
        </div>
        <h2>On-Time Run</h2>
        <p>
          Consecutive due assignments submitted without a late or missing mark.
        </p>
        <% streak_group = achievement_badge_groups.find { |group| group["id"] == "on_time" } %>
        <%= render_partial("streak_progress", binding) %>
      </article>

      <article class="card achievement-card achievement-card-clear">
        <div class="achievement-card-topline">
          <span class="achievement-icon" aria-hidden="true">◇</span>
          <span class="achievement-label">Current streak</span>
        </div>
        <div class="achievement-value">
          <strong><%= achievement_streaks["no_missing"] %></strong>
          <span>school <%= achievement_streaks["no_missing"] == 1 ? "day" : "days" %></span>
        </div>
        <h2>Clear Slate</h2>
        <p>
          <% if missing_count.zero? %>
            Consecutive tracked school days ending with no missing assignments.
          <% else %>
            Clear the missing-work list to begin the next streak.
          <% end %>
        </p>
        <% streak_group = achievement_badge_groups.find { |group| group["id"] == "no_missing" } %>
        <%= render_partial("streak_progress", binding) %>
      </article>

      <article class="card achievement-card achievement-card-scores">
        <div class="achievement-card-topline">
          <span class="achievement-icon" aria-hidden="true">★</span>
          <span class="achievement-label">Current streak</span>
        </div>
        <div class="achievement-value">
          <strong><%= achievement_streaks["strong_scores"] %></strong>
          <span><%= achievement_streaks["strong_scores"] == 1 ? "score" : "scores" %></span>
        </div>
        <h2>Strong Score Streak</h2>
        <p>
          Consecutive graded assignments at <%= strong_score_threshold %>% or higher.
        </p>
        <% streak_group = achievement_badge_groups.find { |group| group["id"] == "strong_scores" } %>
        <%= render_partial("streak_progress", binding) %>
      </article>
    </section>

    <section class="achievement-milestones" aria-labelledby="milestones-heading">
      <div class="achievement-section-heading">
        <span class="achievement-explainer-kicker">Big-picture progress</span>
        <h2 id="milestones-heading">Milestones</h2>
      </div>

      <div class="achievement-milestone-grid">
        <article class="card achievement-milestone-card">
          <span class="achievement-icon" aria-hidden="true">✓</span>
          <div class="achievement-value">
            <strong><%= achievement_milestones["graded_assignments"] %></strong>
            <span>graded assignments</span>
          </div>
          <h3>Work Completed</h3>
          <p>
            Every visible graded assignment adds to this year-long total.
          </p>
          <% streak_group = achievement_badge_groups.find { |group| group["id"] == "graded_assignments" } %>
          <%= render_partial("streak_progress", binding) %>
        </article>

        <article class="card achievement-milestone-card">
          <span class="achievement-icon" aria-hidden="true">🧭</span>
          <div class="achievement-value">
            <strong><%= achievement_milestones.dig("school_year", "completed") %></strong>
            <span>of <%= achievement_milestones.dig("school_year", "total") %> school days</span>
          </div>
          <h3>School Year Journey</h3>
          <p>
            <strong><%= achievement_milestones.dig("school_year", "remaining") %></strong>
            school days remain through <%= school_year_end.strftime("%B %-d") %>.
          </p>
          <% streak_group = achievement_badge_groups.find { |group| group["id"] == "school_year" } %>
          <%= render_partial("streak_progress", binding) %>
        </article>
      </div>
    </section>

    <section class="badge-collection" aria-labelledby="badge-collection-heading">
      <div class="achievement-section-heading">
        <span class="achievement-explainer-kicker">Your trophy shelf</span>
        <h2 id="badge-collection-heading">Badge Collection</h2>
        <p>
          <%= achievement_badge_groups.sum { |group| group["badges"].count { |badge| badge["earned_on"] } } %>
          of 20 collected. Once unlocked, yours to keep!
        </p>
      </div>
      <% achievement_badge_groups.each do |group| %>
        <section class="badge-family" aria-labelledby="badge-family-<%= group["id"] %>">
          <h3 id="badge-family-<%= group["id"] %>"><%= h group["title"] %></h3>
          <div class="badge-grid">
            <% group["badges"].each_with_index do |badge, index| %>
              <article class="card collectible-badge <%= badge["earned_on"] ? "is-earned" : "is-locked" %> badge-tier-<%= index + 1 %>">
                <div class="badge-emblem">
                  <span aria-hidden="true"><%= group["icon"] %></span>
                  <small><%= %w[Common Rare Epic Legend].fetch(index) %></small>
                </div>
                <span class="achievement-label"><%= badge["earned_on"] ? "Unlocked" : "Locked" %></span>
                <h4><%= h badge["name"] %></h4>
                <p>
                  <%= badge["goal"] %><%= group["id"] == "school_year" ? group["unit"] : " #{group["unit"]}" %><%= group["id"] == "strong_scores" ? " at #{strong_score_threshold}% or higher" : "" %>
                </p>
                <% if badge["earned_on"] %>
                  <span class="badge-earned-date">Collected <%= Date.iso8601(badge["earned_on"]).strftime("%b %-d, %Y") %></span>
                <% else %>
                  <progress value="<%= badge["progress"] %>" max="<%= badge["goal"] %>"
                    aria-label="<%= h badge["name"] %> progress"></progress>
                  <span class="badge-earned-date"><%= badge["progress"].floor %> / <%= badge["goal"] %><%= group["id"] == "school_year" ? "%" : "" %></span>
                <% end %>
              </article>
            <% end %>
          </div>
        </section>
      <% end %>
    </section>

    <section class="card achievement-explainer">
      <div>
        <span class="achievement-explainer-kicker">How streaks work</span>
        <h2>Progress without pressure</h2>
      </div>
      <ul>
        <li>Excused work and assignments omitted from the final grade do not count.</li>
        <li>Corrected and custom grades count toward the strong-score streak.</li>
        <li>Weekends do not interrupt the no-missing school-day streak.</li>
        <li>No-missing history builds from the day EmberGuide starts tracking it.</li>
      </ul>
    </section>
  </main>
</body>
</html>
