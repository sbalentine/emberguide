<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#080711">
  <link rel="stylesheet" href="/dashboard.css?v=<%= File.mtime(File.join(APP_ROOT, "public", "dashboard.css")).to_i %>">
  <title>Student Settings</title>
</head>
<body>
  <main class="container settings-page calendar-settings-page">
    <% navigation_active = "settings" %>
    <%= render_partial("navigation", binding) %>
    <header class="settings-header">
      <div>
        <h1>Student</h1>
        <div class="subtitle">Personalize EmberGuide for your student.</div>
      </div>
    </header>
    <% if student_error %>
      <div class="backup-message error" role="alert"><strong>Student settings not saved.</strong> <%= h student_error %></div>
    <% elsif request.query["saved"] == "1" %>
      <div class="backup-message success" role="status"><strong>Student settings saved.</strong></div>
    <% end %>
    <section class="card calendar-settings-card">
      <h2>Birthday</h2>
      <p class="settings-intro">Add an optional birthday to show a cake on the calendar. Only the month and day are saved, never a birth year or age. Anyone with access to EmberGuide can see and edit this setting, and it is included in backups.</p>
      <form method="post" action="/settings/student">
        <label>
          <span>Birthday</span>
          <input name="birthday" type="text" placeholder="MM/DD" pattern="[0-9]{2}/[0-9]{2}" maxlength="5" value="<%= h birthday_value %>" aria-describedby="birthday-help">
          <small id="birthday-help">Enter the month and day as MM/DD, for example 11/15. No year is needed or saved.</small>
        </label>
        <p class="settings-intro">Leave the date blank to remove the birthday.</p>
        <div class="settings-actions">
          <a href="/settings">Cancel</a>
          <button type="submit">Save Student</button>
        </div>
      </form>
    </section>
  </main>
</body>
</html>
