<!doctype html>
<html>
<head>
  <meta charset="utf-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover"
  >

  <meta
    name="apple-mobile-web-app-capable"
    content="yes"
  >

  <meta
    name="apple-mobile-web-app-title"
    content="School"
  >

  <meta
    name="apple-mobile-web-app-status-bar-style"
    content="default"
  >

  <meta
    name="mobile-web-app-capable"
    content="yes"
  >

  <meta
    name="theme-color"
    content="#080711"
  >

  <meta
    http-equiv="refresh"
    content="300"
  >

  <link
    rel="apple-touch-icon"
    href="/emberguide-icon.svg"
  >

  <link
    rel="icon"
    href="/emberguide-icon.svg"
  >

  <link
    rel="manifest"
    href="/manifest.json"
  >

  <link
    rel="stylesheet"
    href="/dashboard.css?v=<%= File.mtime(File.join(APP_ROOT, "public", "dashboard.css")).to_i %>"
  >

  <title>EmberGuide</title>
</head>

<body>
  <main class="container">

    <%
      course_name_mappings =
        begin
          mappings_file =
            if File.directory?("/data")
              "/data/course_name_mappings.json"
            else
              File.join(APP_ROOT, "tmp", "course_name_mappings.json")
            end

          JSON.parse(
            File.read(mappings_file)
          )
        rescue Errno::ENOENT, JSON::ParserError
          {}
        end

      display_course_name = lambda do |course_id|
        canvas_name = course_name(data, course_id).to_s.strip
        course_name_mappings.fetch(course_id.to_s, canvas_name)
      end

      grade_overrides = load_grade_overrides
      data = hide_assignments_from_dashboard(data, grade_overrides)
      valid_grades = combined_grade_submissions(data, grade_overrides)
      grades_by_course = valid_grades.group_by do |submission|
        submission.dig("assignment", "course_id").to_s
      end

      grade_snapshot = grades_by_course.filter_map do |course_id, submissions|
        earned = submissions.sum { |submission| submission["score"].to_f }
        possible = submissions.sum do |submission|
          submission.dig("assignment", "points_possible").to_f
        end
        calculated = percentage(earned, possible)
        next unless calculated

        course_display_name = display_course_name.call(course_id)

        {
          "course_id" => course_id,
          "name" => course_display_name,
          "percentage" => calculated.round,
          "letter" => letter_grade(calculated)
        }
      end.sort_by { |grade| grade["name"] }

      grade_trend_data = grades_by_course.filter_map do |course_id, submissions|
        points = grade_trend_points(submissions)
        next if points.empty?

        current_percentage = points.last["y"]

        {
          "course_id" => course_id,
          "label" => display_course_name.call(course_id),
          "points" => points,
          "current_percentage" => current_percentage,
          "letter" => letter_grade(current_percentage),
          "all_a" => points.all? { |point| point["y"] >= 90 }
        }
      end.sort_by { |course| course["label"] }

      now = Time.now
      today = now.getlocal.to_date
      tomorrow = today + 1
      end_time = now + (7 * 24 * 60 * 60)

      missing = (data["missing"] || []).sort_by do |assignment|
        assignment_due_time(assignment) || Time.at(0)
      end

      upcoming = (data["upcoming"] || []).select do |event|
        due = assignment_due_time(event)
        due && due >= now && due <= end_time
      end.sort_by do |event|
        assignment_due_time(event)
      end

      incomplete_upcoming = upcoming.reject do |event|
        submission_complete?(
          submission_for(
            data,
            assignment_course_id(event),
            assignment_id(event)
          )
        )
      end

      action_candidates = {}

      missing.each do |event|
        key = [
          assignment_course_id(event).to_s,
          assignment_id(event).to_s,
          assignment_name(event)
        ]
        action_candidates[key] = {
          "event" => event,
          "priority" => 0,
          "urgency" => "Missing",
          "urgency_class" => "is-missing"
        }
      end

      incomplete_upcoming.each do |event|
        due = assignment_due_time(event)
        due_date = due.getlocal.to_date
        key = [
          assignment_course_id(event).to_s,
          assignment_id(event).to_s,
          assignment_name(event)
        ]
        priority, urgency, urgency_class =
          if due_date == today
            [1, "Due today", "is-today"]
          elsif due_date == tomorrow
            [2, "Due tomorrow", "is-tomorrow"]
          else
            [3, date_label(due), "is-later"]
          end

        action_candidates[key] ||= {
          "event" => event,
          "priority" => priority,
          "urgency" => urgency,
          "urgency_class" => urgency_class
        }
      end

      module_due_tomorrow_events(
        data,
        known_events: missing + upcoming,
        today: today
      ).each do |event|
        action_candidates[["module", event["course_id"], event["html_url"]]] = {
          "event" => event,
          "priority" => 2,
          "urgency" => "Due tomorrow",
          "urgency_class" => "is-tomorrow"
        }
      end

      next_actions = action_candidates.values.sort_by do |action|
        [
          action["priority"],
          assignment_due_time(action["event"]) || Time.at(0),
          assignment_name(action["event"])
        ]
      end
      visible_next_actions = next_actions.first(3)
      remaining_action_count = [next_actions.length - visible_next_actions.length, 0].max

      todo = (data["todo"] || []).sort_by do |item|
        assignment_due_time(item) || Time.at(Float::INFINITY)
      end

      token_days = token_days_remaining
      token_expiration_date = token_expiration
      district_calendar_events = school_calendar_events(now: now)
      important_calendar_dates = upcoming_school_calendar_events(
        district_calendar_events,
        today: today
      )
      has_more_calendar_dates = district_calendar_events.count do |event|
        event["end_date"] >= today
      end > important_calendar_dates.length
    %>

    <%
      navigation_active = "dashboard"
    %>
    <%= render_partial("navigation", binding) %>

    <!-- =====================================================
         Header
         ===================================================== -->

    <header class="top-header">
      <div class="header-copy">
        <h1>
          <%= h greeting_for(now) %>,
          <%= h profile_first_name(data) %>!
        </h1>

        <div class="subtitle"><%= now.strftime("%A, %B %-d") %></div>
      </div>

      <div class="header-date-mark" aria-hidden="true">
        <span><%= now.strftime("%b") %></span>
        <strong><%= now.strftime("%-d") %></strong>
      </div>
    </header>

    <% unless grade_snapshot.empty? %>
      <section class="grade-snapshot" aria-label="Overall grade snapshot">
        <div class="grade-snapshot-label">Grade snapshot</div>

        <div class="grade-snapshot-list">
          <% grade_snapshot.each do |grade| %>
            <a
              class="grade-snapshot-item grade-<%= grade["letter"].downcase %>"
              href="#grade-course-<%= h grade["course_id"] %>"
              style="--grade-progress: <%= [[grade["percentage"], 0].max, 100].min %>%"
            >
              <span class="grade-snapshot-details">
                <span class="grade-snapshot-course">
                  <%= h grade["name"] %>
                </span>
                <span class="grade-snapshot-score">
                  <strong><%= grade["percentage"] %>%</strong>
                  <span class="grade-snapshot-letter"><%= grade["letter"] %></span>
                </span>
              </span>
              <span class="grade-snapshot-track" aria-hidden="true">
                <span class="grade-snapshot-progress"></span>
              </span>
            </a>
          <% end %>
        </div>
      </section>
    <% end %>

    <% if token_days && token_days <= 7 %>
      <div class="token-expiration-alert" role="alert">
        <div>
          <strong>
            <% if token_days < 0 %>
              Canvas token expired <%= token_days.abs %> days ago.
            <% elsif token_days == 0 %>
              Canvas token expires today.
            <% else %>
              Canvas token expires in <%= token_days %> days.
            <% end %>
          </strong>
          Refresh the access token to keep dashboard updates working.
        </div>

        <a
          href="<%= h "#{BASE_URL}/profile/settings" %>"
          target="_blank"
          rel="noopener noreferrer"
        >
          Open Canvas Settings
        </a>
      </div>
    <% end %>

    <section class="today-summary" aria-labelledby="next-actions-heading">
      <div class="next-actions-header">
        <div>
          <h2 class="dashboard-section-title" id="next-actions-heading">
            What to Do Next
          </h2>
          <p>Incomplete work, ordered by urgency.</p>
        </div>

        <form class="refresh-form" method="post" action="/refresh">
          <button class="refresh-button" type="submit">
            <span class="refresh-button-label">↻ Refresh Canvas</span>
            <span class="refresh-button-progress" aria-hidden="true">
              <span class="refresh-spinner"></span>
              Refreshing…
            </span>
          </button>
        </form>
      </div>

      <% if visible_next_actions.empty? %>
        <div class="next-actions-empty">
          <span aria-hidden="true">✓</span>
          <div>
            <strong>You're all caught up.</strong>
            <small>There is no incomplete work due in the next seven days.</small>
          </div>
        </div>
      <% else %>
        <div class="next-actions-list">
          <% visible_next_actions.each do |action| %>
            <%= render_partial("next_action_card", binding) %>
          <% end %>
        </div>

        <% if remaining_action_count > 0 %>
          <details class="next-actions-more-details">
            <summary class="next-actions-more">
              <span class="next-actions-more-closed">
                <%= remaining_action_count %>
                more <%= remaining_action_count == 1 ? "assignment" : "assignments" %>
                this week
              </span>
              <span class="next-actions-more-open">Show fewer</span>
            </summary>
            <div class="next-actions-list">
              <% next_actions.drop(visible_next_actions.length).each do |action| %>
                <%= render_partial("next_action_card", binding) %>
              <% end %>
            </div>
          </details>
        <% end %>
      <% end %>
    </section>

    <!-- =====================================================
         Canvas Status
         ===================================================== -->

    <% status = dashboard_status %>

    <% if status[:error] %>

      <div class="system-status warning">
        <strong>
          ⚠ Canvas is temporarily unavailable.
        </strong>

        Showing saved data from

        <% if status[:updated_at] %>
          <%= status[:updated_at].strftime("%-I:%M %p") %>.
        <% else %>
          the last update.
        <% end %>

      </div>

    <% end %>

    <% unless important_calendar_dates.empty? %>
      <section class="section calendar-section">
        <div class="section-header">
          <h2 class="dashboard-section-title">Upcoming Schedule Changes</h2>
          <div class="section-header-actions">
            <div class="section-note">Next 30 days</div>
            <% if has_more_calendar_dates %>
              <a class="section-action-link" href="/calendar">
                View Full Calendar
              </a>
            <% end %>
          </div>
        </div>

        <div class="card calendar-card">
          <% important_calendar_dates.each do |event| %>
            <div class="calendar-row">
              <time datetime="<%= event["start_date"].iso8601 %>">
                <span><%= event["start_date"].strftime("%b") %></span>
                <strong><%= event["start_date"].strftime("%-d") %></strong>
              </time>
              <div>
                <strong><%= h event["title"] %></strong>
                <span>
                  <% if event["end_date"] > event["start_date"] %>
                    Through <%= event["end_date"].strftime("%a, %b %-d") %>
                  <% else %>
                    <%= event["start_date"].strftime("%A") %>
                  <% end %>
                  <% unless event["location"].empty? %>
                    · <%= h event["location"] %>
                  <% end %>
                </span>
              </div>
            </div>
          <% end %>

        </div>
      </section>
    <% end %>

    <!-- =====================================================
         Missing Assignments
         ===================================================== -->

    <% unless missing.empty? %>

      <section class="missing-section">

        <div class="missing-heading">

          <div>
            <div class="eyebrow danger-text">
              NEEDS ATTENTION
            </div>

            <h2 class="dashboard-section-title dashboard-section-title-danger">
              Missing Assignments
            </h2>
          </div>

          <div class="missing-count">
            <%= missing.length %>
          </div>

        </div>

        <% missing.each do |assignment| %>

          <%
            course_id = assignment_course_id(assignment)
            due = assignment_due_time(assignment)
            url = assignment_url(assignment)
          %>

          <div class="missing-row">

            <div class="missing-icon">
              !
            </div>

            <div class="assignment-main">

              <div class="assignment-title">

                <% if url %>
                  <a
                    href="<%= h url %>"
                    target="_blank"
                  >
                    <%= h assignment_name(assignment) %>
                  </a>
                <% else %>
                  <%= h assignment_name(assignment) %>
                <% end %>

              </div>

              <div class="assignment-course">
                <%= h display_course_name.call(course_id) %>
              </div>

            </div>

            <div class="assignment-due overdue">

              <strong>
                <%= due ? date_label(due) : "Missing" %>
              </strong>

              <% if due %>
                <span>
                  <%= h due_time_label(due) %>
                </span>
              <% end %>

            </div>

          </div>

        <% end %>

      </section>

    <% end %>

    <!-- =====================================================
         To-do List
         ===================================================== -->

    <section class="section">

      <div class="section-header">
        <h2 class="dashboard-section-title">My To-Dos</h2>
      </div>

      <div class="card todo-card">

        <% if todo.empty? %>

          <div class="empty-state">
            <div class="empty-check">✓</div>

            <div>
              <strong>To-do list complete.</strong>
              <span>Nothing needs attention in Canvas.</span>
            </div>
          </div>

        <% else %>

          <% todo.each do |item| %>
            <%
              course_id = assignment_course_id(item)
              due = assignment_due_time(item)
              calendar_date = due ?
                "#view_name=agenda&view_start=#{due.getlocal.to_date.iso8601}" :
                ""
              url = assignment_url(item) ||
                "#{BASE_URL}/calendar#{calendar_date}"
            %>

            <div class="todo-row">
              <form
                class="todo-complete-form"
                method="post"
                action="/todo/complete"
              >
                <input
                  type="hidden"
                  name="id"
                  value="<%= h item["plannable_id"] %>"
                >

                <button
                  class="todo-checkbox"
                  type="submit"
                  title="Mark complete"
                  aria-label="Mark <%= h assignment_name(item) %> complete"
                >
                  ✓
                </button>
              </form>

              <div class="assignment-main">
                <div class="assignment-title">
                  <a
                    href="<%= h url %>"
                    target="_blank"
                    rel="noopener noreferrer"
                    title="Open in Canvas"
                  >
                    <%= h assignment_name(item) %>
                  </a>
                </div>

                <div class="assignment-course">
                  <%= h display_course_name.call(course_id) %>
                </div>
              </div>

              <% if due %>
                <div class="assignment-due">
                  <strong><%= h date_label(due) %></strong>
                  <span><%= h due_time_label(due) %></span>
                </div>
              <% end %>

              <details class="todo-edit">
                <summary>
                  <span class="todo-edit-pencil" aria-hidden="true">✎</span>
                  <span class="todo-edit-label">
                    Edit <%= h assignment_name(item) %>
                  </span>
                  <span class="todo-edit-cancel">
                    <span aria-hidden="true">&times;</span>
                    Cancel
                  </span>
                </summary>

                <form method="post" action="/todo/update">
                  <input
                    type="hidden"
                    name="id"
                    value="<%= h item["plannable_id"] %>"
                  >

                  <label class="todo-title-field">
                    <span>To-do</span>
                    <input
                      type="text"
                      name="title"
                      maxlength="255"
                      value="<%= h assignment_name(item) %>"
                      required
                    >
                  </label>

                  <label>
                    <span>Date</span>
                    <input
                      type="date"
                      name="todo_date"
                      value="<%= due ? due.getlocal.to_date.iso8601 : today.iso8601 %>"
                      required
                    >
                  </label>

                  <label>
                    <span>Course</span>
                    <select name="course_id">
                      <option value="">Personal</option>
                      <% (data["courses"] || []).sort_by { |course| course["name"] }.each do |course| %>
                        <option
                          value="<%= h course["id"] %>"
                          <%= "selected" if course["id"].to_s == course_id.to_s %>
                        >
                          <%= h display_course_name.call(course["id"]) %>
                        </option>
                      <% end %>
                    </select>
                  </label>

                  <label class="todo-details-field">
                    <span>Details (optional)</span>
                    <textarea name="details" rows="2"><%= h(item.dig("plannable", "details") || item.dig("plannable", "description") || "") %></textarea>
                  </label>

                  <button class="todo-save-button" type="submit">
                    Save Changes
                  </button>
                </form>
              </details>
            </div>
          <% end %>

        <% end %>

        <details class="todo-create">
          <summary>
            <span class="todo-create-open">+ Add To-Do</span>
            <span class="todo-create-cancel">
              <span aria-hidden="true">&times;</span>
              Cancel
            </span>
          </summary>

          <form class="todo-create-form" method="post" action="/todo/create">
            <label class="todo-title-field">
              <span>New to-do</span>
              <input
                type="text"
                name="title"
                maxlength="255"
                placeholder="What needs to be done?"
                required
              >
            </label>

            <label>
              <span>Date</span>
              <input
                type="date"
                name="todo_date"
                value="<%= today.iso8601 %>"
                required
              >
            </label>

            <label>
              <span>Course</span>
              <select name="course_id">
                <option value="">Personal</option>
                <% (data["courses"] || []).sort_by { |course| course["name"] }.each do |course| %>
                  <option value="<%= h course["id"] %>">
                    <%= h display_course_name.call(course["id"]) %>
                  </option>
                <% end %>
              </select>
            </label>

            <label class="todo-details-field">
              <span>Details (optional)</span>
              <textarea name="details" rows="2"></textarea>
            </label>

            <button class="todo-add-button" type="submit">
              + Add To-Do
            </button>
          </form>
        </details>

      </div>

    </section>

    <%= render_partial("this_week_modules", binding) %>

    <!-- =====================================================
         Grades
         ===================================================== -->

    <%
      grade_course_ids = (
        (data["courses"] || []).map { |course| course["id"].to_s } +
        grades_by_course.keys
      ).uniq.sort_by do |course_id|
        display_course_name.call(course_id)
      end
    %>

    <section class="section" id="grades">

      <div class="section-header">

        <h2 class="dashboard-section-title">
          Grades
        </h2>

      </div>

      <% unless grade_trend_data.empty? %>
        <div class="grade-trend-summary">
          <div class="grade-trend-heading">
            <div>
              <h3>Grade trends</h3>
              <p>
                A quick look at how each class is going this term
              </p>
            </div>
          </div>

          <div class="grade-trend-grid">
            <% grade_trend_data.each_with_index do |course, index| %>
              <article class="grade-trend-course-card grade-<%= h course["letter"].downcase %>">
                <div class="grade-trend-course-copy">
                  <div>
                    <h4><%= h course["label"] %></h4>
                    <p class="grade-trend-encouragement">
                      <% if course["all_a"] %>
                        A throughout the term
                      <% elsif course["current_percentage"] >= 90 %>
                        Currently in the A range
                      <% elsif course["current_percentage"] >= 80 %>
                        Currently in the B range
                      <% elsif course["current_percentage"] >= 70 %>
                        Currently in the C range
                      <% else %>
                        Keep going
                      <% end %>
                    </p>
                  </div>

                  <div class="grade-trend-current">
                    <strong><%= h format_number(course["current_percentage"]) %>%</strong>
                    <span><%= h course["letter"] %></span>
                  </div>
                </div>

                <div class="grade-trend-sparkline">
                  <canvas
                    id="grade-trend-<%= h course["course_id"] %>"
                    data-grade-trend-index="<%= index %>"
                    role="img"
                    aria-label="<%= h course["label"] %> cumulative grade trend"
                  >
                    <%= h course["label"] %> grade trend
                  </canvas>
                </div>

                <div class="grade-trend-scale" aria-hidden="true">
                  <span>A–F scale</span>
                  <span><%= course["points"].length %> graded <%= course["points"].length == 1 ? "assignment" : "assignments" %></span>
                </div>
              </article>
            <% end %>
          </div>

          <script id="grade-trend-data" type="application/json"><%= json_for_html_script(grade_trend_data) %></script>
        </div>
      <% end %>

      <% grade_course_ids.each do |course_id| %>

        <%
          submissions = grades_by_course.fetch(course_id, [])

          earned = submissions.sum do |submission|
            submission["score"].to_f
          end

          possible = submissions.sum do |submission|
            submission.dig(
              "assignment",
              "points_possible"
            ).to_f
          end

          calculated = percentage(
            earned,
            possible
          )

          displayed_percentage = calculated
          displayed_letter = letter_grade(displayed_percentage)

          recent = submissions.sort_by do |submission|
            submission["graded_at"] ||
              submission.dig(
                "assignment",
                "due_at"
              ) ||
              ""
          end.reverse
        %>

        <section
          class="grade-card"
          id="grade-course-<%= h course_id %>"
        >

          <div class="grade-header<%= displayed_letter&.match?(/\A[A-F]\z/) ? " grade-#{displayed_letter.downcase}" : "" %>">

            <div>

              <h3>
                <%= h display_course_name.call(course_id) %>
              </h3>

              <div class="grade-meta">
                <% if submissions.empty? %>
                  No graded assignments
                <% else %>
                  <%= submissions.length %>
                  graded <%= submissions.length == 1 ? "assignment" : "assignments" %>
                  ·
                  <%= h format_number(earned) %>
                  /
                  <%= h format_number(possible) %>
                  pts
                <% end %>
              </div>

              <a
                class="grade-card-edit-link"
                href="/settings/grades?course_id=<%= h CGI.escape(course_id) %>"
              >
                Edit this class
              </a>

            </div>

            <div class="grade-percent">
              <% if displayed_percentage %>
                <span class="grade-value"><%= h format_number(displayed_percentage) %>%</span>
              <% end %>
              <% if displayed_letter %>
                <span class="grade-letter"><%= h displayed_letter %></span>
              <% elsif displayed_percentage.nil? %>
                —
              <% else %>
                <span class="grade-letter"><%= h letter_grade(displayed_percentage) %></span>
              <% end %>
            </div>

          </div>

          <% unless recent.empty? %>
            <div class="recent-label">
              RECENT CANVAS GRADES
            </div>
          <% end %>

          <div class="grade-list">
            <% recent.each do |submission| %>

              <%
                assignment = submission["assignment"]

                score = submission["score"]
                points = assignment["points_possible"]

                pct = percentage(
                  score,
                  points
                )

                url = assignment["html_url"]
                official_override = submission["_official_override"]

                grade_class =
                  if pct && pct < 70
                    " low-grade"
                  elsif pct && pct < 80
                    " warning-grade"
                  else
                    ""
                  end
              %>

              <div class="grade-row<%= grade_class %>">

                <div class="assignment-main">

                  <div class="assignment-title">

                    <% if url %>
                      <a
                        href="<%= h url %>"
                        target="_blank"
                      >
                        <%= h assignment["name"] %>
                      </a>
                    <% else %>
                      <%= h assignment["name"] %>
                    <% end %>

                  </div>

                  <div class="assignment-course">
                    <%= h grade_date(
                      submission["graded_at"] ||
                      assignment["due_at"]
                    ) %>
                    <% if official_override %>
                      <span class="official-grade-badge">Edited</span>
                    <% end %>
                  </div>

                </div>

                <div class="grade-score">

                  <strong>
                    <%= h format_number(score) %>
                    /
                    <%= h format_number(points) %>
                  </strong>

                  <% if pct %>
                    <span<%= pct == 100 ? ' class="perfect-score" title="Perfect score!"' : "" %>>
                      <%= pct %>%
                    </span>
                  <% end %>

                  <% if official_override && !submission["_custom_grade"] %>
                    <span class="canvas-grade-original">
                      Canvas:
                      <%= h format_number(submission["_canvas_score"]) %>/<%= h format_number(submission["_canvas_points_possible"]) %>
                    </span>
                  <% end %>

                </div>

              </div>

            <% end %>
          </div>

          <% if recent.length > 5 %>
            <button
              class="grade-more-button"
              type="button"
              hidden
            >
              See more
            </button>
          <% end %>

        </section>

      <% end %>

    </section>

    <footer class="site-footer">
      <% if status[:updated_at] %>
        <div class="canvas-update-footer">
          <span aria-hidden="true"></span>
          Canvas updated <%= status[:updated_at].strftime("%-I:%M %p") %>
        </div>
      <% end %>

      <% if token_days %>
        <div class="token-footer">
          🔑 Canvas token:
          <% if token_days < 0 %>
            expired <%= token_days.abs %> days ago
          <% else %>
            <%= token_days %> days remaining
          <% end %>

          <% if token_expiration_date %>
            <span>
              Expires <%= token_expiration_date.strftime("%b %-d, %Y") %>
            </span>
          <% end %>
        </div>
      <% end %>

    </footer>

  </main>

  <script src="/chart.umd.min.js?v=4.5.1"></script>
  <script>
    const trendDataElement = document.getElementById("grade-trend-data");

    if (trendDataElement) {
      const trendData = JSON.parse(trendDataElement.textContent);
      const colors = [
        "#8583ff",
        "#4fd6a0",
        "#ff8a5b",
        "#58a6ff",
        "#ffc96b",
        "#c084fc",
        "#ff7085"
      ];
      const formatNumber = (value) => (
        Number.isInteger(value) ? value.toString() : value.toFixed(1)
      );
      const trendTimestamps = trendData.flatMap((course) => (
        course.points.map((point) => point.x)
      ));
      const firstTrendDate = new Date(Math.min(...trendTimestamps));
      const lastTrendDate = new Date(Math.max(...trendTimestamps));
      const trendStart = new Date(
        firstTrendDate.getFullYear(),
        firstTrendDate.getMonth(),
        1
      ).getTime();
      const trendEnd = new Date(
        lastTrendDate.getFullYear(),
        lastTrendDate.getMonth() + 1,
        1
      ).getTime() - 1;
      const trendMonths = [];
      const monthCursor = new Date(trendStart);

      while (monthCursor.getTime() <= trendEnd) {
        trendMonths.push(monthCursor.getTime());
        monthCursor.setMonth(monthCursor.getMonth() + 1);
      }
      const gradeBands = {
        id: "gradeBands",
        beforeDraw(chart) {
          const { ctx, chartArea, scales } = chart;

          if (!chartArea) return;

          const bands = [
            { top: 105, bottom: 90, color: "rgba(79, 214, 160, 0.10)" },
            { top: 90, bottom: 80, color: "rgba(88, 166, 255, 0.07)" },
            { top: 80, bottom: 70, color: "rgba(255, 201, 107, 0.07)" },
            { top: 70, bottom: 60, color: "rgba(255, 138, 91, 0.06)" },
            { top: 60, bottom: 50, color: "rgba(255, 112, 133, 0.06)" }
          ];

          ctx.save();
          bands.forEach((band) => {
            const top = scales.y.getPixelForValue(band.top);
            const bottom = scales.y.getPixelForValue(band.bottom);

            ctx.fillStyle = band.color;
            ctx.fillRect(
              chartArea.left,
              top,
              chartArea.right - chartArea.left,
              bottom - top
            );
          });
          ctx.restore();
        }
      };

      document.querySelectorAll("[data-grade-trend-index]").forEach((canvas) => {
        const index = Number(canvas.dataset.gradeTrendIndex);
        const course = trendData[index];
        const color = colors[index % colors.length];

        new Chart(canvas, {
          type: "line",
          data: {
            datasets: [{
              label: course.label,
              data: course.points,
              borderColor: color,
              backgroundColor: color,
              borderWidth: 2.5,
              pointRadius(context) {
                const points = context.dataset.data;
                const index = context.dataIndex;

                if (index === 0) return 3;

                return points[index].y === points[index - 1].y ? 0 : 3;
              },
              pointHoverRadius: 5,
              pointHitRadius: 12,
              pointBorderColor: "#121020",
              pointBorderWidth: 2,
              tension: 0.3
            }]
          },
          plugins: [gradeBands],
          options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: {
              mode: "nearest",
              intersect: false
            },
            plugins: {
              legend: {
                display: false
              },
              tooltip: {
                displayColors: false,
                filter(context) {
                  const points = context.dataset.data;
                  const index = context.dataIndex;

                  return index === 0 || points[index].y !== points[index - 1].y;
                },
                callbacks: {
                  title(items) {
                    const point = items[0]?.raw;

                    if (!point?.x) return "";

                    return new Date(point.x).toLocaleDateString(
                      undefined,
                      { month: "short", day: "numeric", year: "numeric" }
                    );
                  },
                  label(context) {
                    const point = context.raw;
                    const assignmentPercentage =
                      (point.score / point.points_possible) * 100;

                    return [
                      point.assignment,
                      `Assignment: ${formatNumber(point.score)}/${formatNumber(point.points_possible)} pts (${formatNumber(assignmentPercentage)}%)`,
                      `Course grade: ${formatNumber(point.y)}%`
                    ];
                  },
                  afterLabel(context) {
                    const point = context.raw;

                    return `Running total: ${formatNumber(point.earned)}/${formatNumber(point.possible)} pts`;
                  }
                }
              }
            },
            scales: {
              x: {
                type: "linear",
                display: true,
                min: trendStart,
                max: trendEnd,
                afterBuildTicks(axis) {
                  axis.ticks = trendMonths.map((value) => ({
                    value
                  }));
                },
                border: {
                  display: false
                },
                grid: {
                  display: false
                },
                ticks: {
                  color: "#77748d",
                  maxRotation: 0,
                  padding: 6,
                  font: {
                    size: 9,
                    weight: "600"
                  },
                  callback(value) {
                    return new Date(value).toLocaleDateString(
                      undefined,
                      { month: "short" }
                    );
                  }
                }
              },
              y: {
                display: true,
                min: 50,
                max: 105,
                afterBuildTicks(axis) {
                  axis.ticks = [55, 65, 75, 85, 95].map((value) => ({
                    value
                  }));
                },
                border: {
                  display: false
                },
                grid: {
                  color: "rgba(174, 171, 209, 0.12)",
                  drawTicks: false
                },
                ticks: {
                  color: "#9b98b2",
                  padding: 8,
                  font: {
                    size: 11,
                    weight: "700"
                  },
                  callback(value) {
                    return {
                      95: "A",
                      85: "B",
                      75: "C",
                      65: "D",
                      55: "F"
                    }[value];
                  }
                }
              }
            }
          }
        });
      });
    }

    document.querySelector(".refresh-form").addEventListener("submit", (event) => {
      const button = event.currentTarget.querySelector(".refresh-button");

      button.classList.add("is-refreshing");
      button.disabled = true;
      button.setAttribute("aria-label", "Refreshing Canvas");
    });

    document.querySelectorAll(".todo-complete-form").forEach((form) => {
      form.addEventListener("submit", () => {
        const row = form.closest(".todo-row");
        const button = form.querySelector(".todo-checkbox");

        row.classList.add("is-completing");
        button.disabled = true;
        button.setAttribute("aria-label", "Marking to-do complete");
      });
    });

    document.querySelectorAll(".grade-card").forEach((card) => {
      const rows = Array.from(
        card.querySelectorAll(".grade-list > .grade-row")
      );
      const button = card.querySelector(".grade-more-button");

      if (!button || rows.length <= 5) return;

      let visibleCount = 5;
      rows.slice(visibleCount).forEach((row) => {
        row.hidden = true;
      });
      button.hidden = false;

      button.addEventListener("click", () => {
        const nextCount = Math.min(visibleCount + 5, rows.length);

        rows.slice(visibleCount, nextCount).forEach((row) => {
          row.hidden = false;
        });

        visibleCount = nextCount;
        button.hidden = visibleCount >= rows.length;
      });
    });

  </script>
</body>
</html>
