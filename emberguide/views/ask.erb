<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#080711">
  <link rel="stylesheet" href="/dashboard.css?v=<%= File.mtime(File.join(APP_ROOT, "public", "dashboard.css")).to_i %>">
  <title>Spark</title>
</head>
<body>
  <main class="container settings-page ask-page">
    <% navigation_active = "ask" %>
    <%= render_partial("navigation", binding) %>
    <header class="settings-header">
      <div>
        <h1>Spark</h1>
        <div class="subtitle">Your homework helper. Ask about classes, homework, and grades, answered from what EmberGuide has saved.</div>
      </div>
      <span class="ask-status" data-ask-status>Checking Spark&hellip;</span>
    </header>

    <% if !ai_enabled? %>
      <section class="card ask-setup">
        <h2>Set up Spark</h2>
        <p>Spark uses a llama.cpp server on your home network. Set <code>LLM_URL</code> (for example <code>http://192.168.1.50:8080</code>), and optionally <code>LLM_API_KEY</code> and <code>LLM_MODEL</code>, in <code>.env</code> or the Home Assistant add-on options, then restart EmberGuide.</p>
      </section>
    <% elsif !data %>
      <section class="card ask-setup">
        <p>Waiting for Canvas data. Refresh from the dashboard first.</p>
      </section>
    <% else %>
      <section class="card ask-card" aria-label="Conversation">
        <div class="ask-log" data-ask-log aria-live="polite">
          <p class="ask-empty" data-ask-empty>Try one of these, or type your own question.</p>
        </div>
        <div class="ask-suggestions" data-ask-suggestions>
          <% ["What should I focus on tonight?", "Summarize this week in each class.", "What should I study for upcoming tests?", "Which class needs the most attention right now?"].each do |suggestion| %>
            <button type="button" class="ask-suggestion"><%= h suggestion %></button>
          <% end %>
        </div>
        <form class="ask-form" data-ask-form>
          <label class="module-sr-only" for="ask-input">Your question</label>
          <textarea id="ask-input" name="question" rows="2" maxlength="<%= AI_MAX_MESSAGE_CHARS %>" placeholder="Ask Spark about homework, tests, or grades&hellip;" required></textarea>
          <div class="ask-actions">
            <button type="button" class="ask-clear" data-ask-clear>New conversation</button>
            <button type="submit" class="ask-send">Ask</button>
          </div>
        </form>
        <p class="ask-footnote">Spark runs on a local AI model and can be wrong. Check Canvas or ask the teacher for anything important.</p>
      </section>

      <details class="card ask-context">
        <summary>What Spark can see (about <%= format_number((ai_context.length / 4.0).round(-2)) %> tokens)</summary>
        <pre><%= h ai_context %></pre>
      </details>
    <% end %>
  </main>
  <script src="/ask.js?v=<%= File.mtime(File.join(APP_ROOT, "public", "ask.js")).to_i %>" defer></script>
</body>
</html>
