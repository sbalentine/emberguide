<nav class="dashboard-nav" aria-label="Main navigation">
  <a class="dashboard-brand" href="/">
    <span class="dashboard-brand-mark" aria-hidden="true">
      <svg viewBox="0 0 512 512" focusable="false">
        <defs>
          <linearGradient id="nav-logo-background" x1="64" y1="32" x2="448" y2="480">
            <stop stop-color="#211d39"/>
            <stop offset="1" stop-color="#0d0b18"/>
          </linearGradient>
          <linearGradient id="nav-logo-ember" x1="100" y1="60" x2="420" y2="460">
            <stop stop-color="#ffc96b"/>
            <stop offset="0.55" stop-color="#ff8a5b"/>
            <stop offset="1" stop-color="#d96f76"/>
          </linearGradient>
          <linearGradient id="nav-logo-path" x1="180" y1="230" x2="320" y2="430">
            <stop stop-color="#aaa8ff"/>
            <stop offset="1" stop-color="#6663f2"/>
          </linearGradient>
        </defs>
        <rect width="512" height="512" rx="110" fill="url(#nav-logo-background)"/>
        <g transform="scale(3.2)">
          <g transform="translate(2 -30) scale(.98)">
            <path
              d="M81 36c31 34 56 59 56 91 0 35-25 60-57 60-34 0-58-26-58-60 0-27 15-49 38-75-2 22 6 35 19 43 11-18 11-37 2-59z"
              fill="none"
              stroke="url(#nav-logo-ember)"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="16"
            />
            <path
              d="M80 112c11 12 20 22 20 34 0 12-8 21-20 21-11 0-20-9-20-21 0-10 7-21 20-34z"
              fill="url(#nav-logo-path)"
            />
          </g>
        </g>
      </svg>
    </span>
    <strong>EmberGuide</strong>
  </a>

  <button
    class="dashboard-nav-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="dashboard-nav-links"
    aria-label="Open navigation menu"
  >
    <span></span>
    <span></span>
    <span></span>
  </button>

  <div class="dashboard-nav-links" id="dashboard-nav-links">
    <a class="<%= "is-active" if navigation_active == "dashboard" %>" href="/">
      Dashboard
    </a>
    <a class="<%= "is-active" if navigation_active == "calendar" %>" href="/calendar">
      Calendar
    </a>
    <a class="<%= "is-active" if navigation_active == "modules" %>" href="/modules">
      Modules
    </a>
    <% if ai_enabled? %>
      <a class="<%= "is-active" if navigation_active == "ask" %>" href="/ask">
        Spark
      </a>
    <% end %>
    <a class="<%= "is-active" if navigation_active == "achievements" %>" href="/achievements">
      Achievements
    </a>
    <a class="<%= "is-active" if navigation_active == "settings" %>" href="/settings">
      Settings
    </a>
  </div>

  <%
    profile_name = navigation_profile_name
  %>
  <div class="dashboard-profile">
    <span aria-hidden="true"><%= h profile_name[0]&.upcase %></span>
    <div>
      <strong><%= h profile_name %></strong>
      <small>Student dashboard</small>
    </div>
  </div>
</nav>

<script
  src="/navigation.js?v=<%= File.mtime(File.join(APP_ROOT, "public", "navigation.js")).to_i %>"
  defer
></script>
