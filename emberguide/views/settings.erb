<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover"
  >
  <meta name="theme-color" content="#080711">
  <link
    rel="stylesheet"
    href="/dashboard.css?v=<%= File.mtime(File.join(APP_ROOT, "public", "dashboard.css")).to_i %>"
  >
  <title>Settings</title>
</head>

<body>
  <main class="container settings-page settings-hub-page">
    <%
      navigation_active = "settings"
    %>
    <%= render_partial("navigation", binding) %>

    <header class="settings-header">
      <div>
        <h1>Settings</h1>
        <div class="subtitle">Manage classes, grades, and notifications.</div>
      </div>
    </header>

    <nav class="settings-grid" aria-label="Dashboard settings">
      <a class="card settings-link-card" href="/settings/classes">
        <strong>Classes</strong>
        <span>Rename, hide, or add classes.</span>
      </a>
      <a class="card settings-link-card" href="/settings/grades">
        <strong>Grades</strong>
        <span>Correct scores and manage assignments outside Canvas.</span>
      </a>
      <a class="card settings-link-card" href="/settings/calendar">
        <strong>Calendar</strong>
        <span>Configure the district calendar feed and event filters.</span>
      </a>
      <a class="card settings-link-card" href="/settings/achievements">
        <strong>Achievements</strong>
        <span>Choose the target used for strong-score streaks.</span>
      </a>
      <a class="card settings-link-card" href="/settings/emails">
        <strong>Scheduled Emails</strong>
        <span>Configure daily summaries and backup deliveries.</span>
      </a>
      <a class="card settings-link-card" href="/settings/backup">
        <strong>Data Backup</strong>
        <span>Export or restore dashboard data and local settings.</span>
      </a>
      <a class="card settings-link-card" href="/settings/spark">
        <strong>Spark</strong>
        <span>Check the homework helper's connection and model.</span>
      </a>
    </nav>
  </main>
</body>
</html>
