<%
  coursework = load_manual_coursework if !defined?(coursework) || coursework.nil?
  selected_course_id = nil unless defined?(selected_course_id)
  selected_course = nil unless defined?(selected_course)
  selected_course_name =
    if selected_course
      mappings.fetch(selected_course["id"].to_s, selected_course["name"])
    end
  manual_selected_course_id =
    if selected_course&.fetch("_manual", false)
      selected_course_id.delete_prefix("manual-")
    end
  show_manual_assignments =
    selected_course_id.nil? || !manual_selected_course_id.nil?
  visible_manual_courses =
    coursework["courses"].select do |id, _course|
      manual_selected_course_id.nil? || id == manual_selected_course_id
    end
  grading_settings = course_grading_settings(overrides, selected_course_id)
%>
<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover"
  >
  <meta name="theme-color" content="#080711">
  <link
    rel="stylesheet"
    href="/dashboard.css?v=<%= File.mtime(File.join(APP_ROOT, "public", "dashboard.css")).to_i %>"
  >
  <title><%= selected_course ? "Edit #{h selected_course_name} Grades" : "Edit Assignment Grades" %></title>
</head>

<body>
  <main class="container settings-page grade-settings-page">
    <%
      navigation_active = "settings"
    %>
    <%= render_partial("navigation", binding) %>

    <header class="settings-header">
      <div>
        <h1>
          <%= selected_course ? "Edit #{h selected_course_name} Grades" : "Edit Assignment Grades" %>
        </h1>
        <div class="subtitle">
          Correct scores, add external grades, and manage assignments outside Canvas.
        </div>
      </div>

    </header>

    <nav class="grade-course-filter" aria-label="Choose a class">
      <a class="<%= "is-selected" unless selected_course %>" href="/settings/grades">
        All Classes
      </a>
      <% (data["courses"] || []).sort_by { |course| course["name"] }.each do |course| %>
        <a
          class="<%= "is-selected" if selected_course_id == course["id"].to_s %>"
          href="/settings/grades?course_id=<%= h CGI.escape(course["id"].to_s) %>"
        >
          <%= h mappings.fetch(course["id"].to_s, course["name"]) %>
        </a>
      <% end %>
    </nav>

    <form class="grade-settings" method="post" action="/settings/grades">
      <% if selected_course_id %>
        <input type="hidden" name="course_id" value="<%= h selected_course_id %>">
      <% end %>

      <% if selected_course_id %>
        <section class="card course-grading-settings">
          <h2>Course grading</h2>
          <label>
            <span>Grading method</span>
            <select name="grading_mode">
              <option value="points" <%= "selected" if grading_settings["mode"] == "points" %>>Total points (default)</option>
              <option value="weighted" <%= "selected" if grading_settings["mode"] == "weighted" %>>Weighted categories</option>
            </select>
          </label>
          <p class="settings-intro">
            Define category weights for this class, then choose a category for each assignment below.
            Within a category, grades use total earned / possible points. Active weights are normalized:
            empty categories are skipped, and 0% categories never affect the course average.
            Uncategorized graded work is excluded until assigned; an amber marker beside the provisional course grade links back here.
            Canvas score updates do not clear category choices. Clear a category's name and weight to remove it.
          </p>
          <div id="grading-categories">
            <% (grading_settings["categories"].to_a + [[SecureRandom.uuid, { "name" => "", "weight" => nil }]]).each do |id, category| %>
              <div class="grading-category-row" data-category-id="<%= h id %>">
                <label>
                  <span>Category name</span>
                  <input name="grading_category_<%= h id %>_name" value="<%= h category["name"] %>" maxlength="80" data-category-name>
                </label>
                <label>
                  <span>Weight (%)</span>
                  <input type="number" name="grading_category_<%= h id %>_weight" value="<%= h category["weight"] %>" min="0" max="100" step="0.01" data-category-weight>
                </label>
              </div>
            <% end %>
          </div>
          <button type="button" class="add-grade-row" id="add-grading-category">+ Add category</button>
          <p class="settings-help">Weights may total less than 100% (for example 35%, 40%, and 0%), but not more than 100%.</p>
        </section>
      <% else %>
        <p class="settings-help">Choose a class above to configure its grading method, category weights, and assignment categories.</p>
      <% end %>

      <section class="card">
        <h2>Canvas Assignments</h2>
        <p class="settings-intro">
          Leave both fields blank to use Canvas. Enter only the value that needs correcting.
          Select "Hide until Canvas updates" to hide an incorrect assignment from the dashboard
          and daily digest and exclude it from calculated grades. It returns automatically when
          Canvas changes its score, possible points, or grading timestamp. Uncheck to restore it manually.
          Ungraded and upcoming Canvas assignments are included so they can also be hidden.
        </p>

        <div class="assignment-grade-list">
          <%
            canvas_grades = editable_canvas_submissions(data).select do |submission|
              submission["assignment"] && (
                submission["assignment_id"] ||
                submission.dig("assignment", "id")
              ) && (
                selected_course_id.nil? ||
                submission.dig("assignment", "course_id").to_s == selected_course_id
              )
            end.sort_by do |submission|
              [
                parse_canvas_time(
                  submission["graded_at"] ||
                  submission.dig("assignment", "due_at")
                ) || Time.at(0),
                submission.dig("assignment", "name").to_s
              ]
            end.reverse
          %>

          <% canvas_grades.each do |submission| %>
            <%
              assignment = submission["assignment"]
              assignment_id = (
                submission["assignment_id"] ||
                assignment["id"]
              ).to_s
              override = overrides.fetch("canvas", {}).fetch(assignment_id, {})
              course_id = assignment["course_id"].to_s
              edited_percentage = percentage(
                override["score"] || submission["score"],
                override["points_possible"] || assignment["points_possible"]
              )
            %>

            <div class="assignment-grade-row<%= " is-edited" unless override.empty? %>">
              <div class="assignment-grade-name">
                <div class="assignment-grade-title">
                  <strong><%= h assignment["name"] %></strong>
                  <% unless override.empty? %>
                    <span class="edited-assignment-label"><%= override["hidden"] == true ? "Hidden" : "Edited" %></span>
                  <% end %>
                </div>
                <span>
                  <%= h mappings.fetch(course_id, course_name(data, course_id)) %>
                  · Canvas:
                  <% if submission["score"].nil? %>
                    No grade
                  <% else %>
                    <%= h format_number(submission["score"]) %>/<%= h format_number(assignment["points_possible"]) %>
                    <%= grade_badge(percentage(submission["score"], assignment["points_possible"])) %>
                  <% end %>
                </span>
                <% unless override.empty? || override["hidden"] == true %>
                  <%= grade_badge(edited_percentage, label: "Edited: #{format_number(edited_percentage)}%") %>
                <% end %>
                <label class="assignment-grade-hide">
                  <input
                    type="checkbox"
                    name="canvas_<%= h assignment_id %>_hidden"
                    value="true"
                    <%= "checked" if override["hidden"] == true %>
                    aria-label="Hide <%= h assignment["name"] %> until Canvas updates"
                  >
                  <span>Hide until Canvas updates</span>
                </label>
              </div>

              <label>
                <span>Earned</span>
                <input
                  type="number"
                  name="canvas_<%= h assignment_id %>_score"
                  value="<%= h override["score"] %>"
                  min="0"
                  max="99999"
                  step="0.01"
                  inputmode="decimal"
                  placeholder="<%= h format_number(submission["score"]) %>"
                >
              </label>

              <label>
                <span>Possible</span>
                <input
                  type="number"
                  name="canvas_<%= h assignment_id %>_points"
                  value="<%= h override["points_possible"] %>"
                  min="0"
                  max="99999"
                  step="0.01"
                  inputmode="decimal"
                  placeholder="<%= h format_number(assignment["points_possible"]) %>"
                >
              </label>
              <% grade_category_prefix = "canvas_#{assignment_id}"; grade_category_key = "canvas-#{assignment_id}" %>
              <%= render_partial("grade_category_select", binding) %>
            </div>
          <% end %>
        </div>
      </section>

      <section class="card">
        <h2>Infinite Campus-only Assignments</h2>
        <p class="settings-intro">
          Clear an assignment name to remove that added grade.
        </p>

        <% overrides.fetch("custom", {}).each do |grade_id, grade| %>
          <% next if selected_course_id && grade["course_id"].to_s != selected_course_id %>
          <div class="custom-grade-row">
            <label class="custom-grade-name">
              <span>Assignment</span>
              <%= grade_badge(percentage(grade["score"], grade["points_possible"])) %>
              <input
                type="text"
                name="custom_<%= h grade_id %>_name"
                value="<%= h grade["name"] %>"
                maxlength="255"
              >
            </label>

            <label>
              <span>Course</span>
              <select name="custom_<%= h grade_id %>_course_id">
                <% (data["courses"] || []).select { |course| selected_course_id.nil? || course["id"].to_s == selected_course_id }.each do |course| %>
                  <option
                    value="<%= h course["id"] %>"
                    <%= "selected" if course["id"].to_s == grade["course_id"].to_s %>
                  >
                    <%= h mappings.fetch(course["id"].to_s, course["name"]) %>
                  </option>
                <% end %>
              </select>
            </label>

            <label>
              <span>Earned</span>
              <input
                type="number"
                name="custom_<%= h grade_id %>_score"
                value="<%= h grade["score"] %>"
                min="0"
                max="99999"
                step="0.01"
                inputmode="decimal"
              >
            </label>

            <label>
              <span>Possible</span>
              <input
                type="number"
                name="custom_<%= h grade_id %>_points"
                value="<%= h grade["points_possible"] %>"
                min="0"
                max="99999"
                step="0.01"
                inputmode="decimal"
              >
            </label>

            <label>
              <span>Date</span>
              <input
                type="date"
                name="custom_<%= h grade_id %>_date"
                value="<%= h grade["graded_at"] %>"
              >
            </label>
            <% grade_category_prefix = "custom_#{grade_id}"; grade_category_key = "custom-#{grade_id}" %>
            <%= render_partial("grade_category_select", binding) %>
          </div>
        <% end %>

        <div id="new-custom-grades">
          <div class="custom-grade-row new-custom-grade">
            <label class="custom-grade-name">
              <span>New assignment</span>
              <input
                type="text"
                name="new_0_name"
                maxlength="255"
                placeholder="Assignment name"
              >
            </label>

            <label>
              <span>Course</span>
              <select name="new_0_course_id">
                <% (data["courses"] || []).select { |course| selected_course_id.nil? || course["id"].to_s == selected_course_id }.each do |course| %>
                  <option value="<%= h course["id"] %>">
                    <%= h mappings.fetch(course["id"].to_s, course["name"]) %>
                  </option>
                <% end %>
              </select>
            </label>

            <label>
              <span>Earned</span>
              <input
                type="number"
                name="new_0_score"
                min="0"
                max="99999"
                step="0.01"
                inputmode="decimal"
              >
            </label>

            <label>
              <span>Possible</span>
              <input
                type="number"
                name="new_0_points"
                min="0"
                max="99999"
                step="0.01"
                inputmode="decimal"
              >
            </label>

            <label>
              <span>Date</span>
              <input type="date" name="new_0_date" value="<%= Date.today.iso8601 %>">
            </label>

            <button
              class="remove-new-grade"
              type="button"
              aria-label="Remove new assignment"
              title="Remove"
            >
              ×
            </button>
            <% grade_category_prefix = "new_0"; grade_category_key = nil %>
            <%= render_partial("grade_category_select", binding) %>
          </div>
        </div>

        <button class="add-grade-row" id="add-grade-row" type="button">
          + Add another assignment
        </button>

        <template id="new-grade-template">
          <div class="custom-grade-row new-custom-grade">
            <label class="custom-grade-name">
              <span>New assignment</span>
              <input
                type="text"
                name="new___INDEX___name"
                maxlength="255"
                placeholder="Assignment name"
              >
            </label>

            <label>
              <span>Course</span>
              <select name="new___INDEX___course_id">
                <% (data["courses"] || []).select { |course| selected_course_id.nil? || course["id"].to_s == selected_course_id }.each do |course| %>
                  <option value="<%= h course["id"] %>">
                    <%= h mappings.fetch(course["id"].to_s, course["name"]) %>
                  </option>
                <% end %>
              </select>
            </label>

            <label>
              <span>Earned</span>
              <input
                type="number"
                name="new___INDEX___score"
                min="0"
                max="99999"
                step="0.01"
                inputmode="decimal"
              >
            </label>

            <label>
              <span>Possible</span>
              <input
                type="number"
                name="new___INDEX___points"
                min="0"
                max="99999"
                step="0.01"
                inputmode="decimal"
              >
            </label>

            <label>
              <span>Date</span>
              <input
                type="date"
                name="new___INDEX___date"
                value="<%= Date.today.iso8601 %>"
              >
            </label>

            <button
              class="remove-new-grade"
              type="button"
              aria-label="Remove new assignment"
              title="Remove"
            >
              ×
            </button>
            <% grade_category_prefix = "new___INDEX__"; grade_category_key = nil %>
            <%= render_partial("grade_category_select", binding) %>
          </div>
        </template>
      </section>

      <p class="settings-help">
        Edited values are stored only in this dashboard and are not sent to Canvas or
        Infinite Campus.
      </p>

      <div class="settings-actions">
        <a href="/">Cancel</a>
        <button type="submit">Save Assignment Grades</button>
      </div>
    </form>

    <% if show_manual_assignments %>
      <section class="card coursework-settings-section manual-assignment-settings">
        <h2>Assignments Outside Canvas</h2>
        <p class="settings-intro">
          Add upcoming work for classes managed in EmberGuide.
        </p>

        <div class="coursework-list">
          <%
            assignments = coursework["assignments"].select do |_id, assignment|
              manual_selected_course_id.nil? ||
                assignment["course_id"] == manual_selected_course_id
            end.sort_by do |_id, assignment|
              assignment["due_at"]
            end
          %>
          <% assignments.each do |id, assignment| %>
            <form class="coursework-row assignment-coursework-row" method="post" action="/settings/grades">
              <input type="hidden" name="action" value="update_assignment">
              <input type="hidden" name="id" value="<%= h id %>">
              <% if selected_course_id %>
                <input type="hidden" name="selected_course_id" value="<%= h selected_course_id %>">
              <% end %>

              <label class="coursework-name-field">
                <span>Assignment</span>
                <input
                  type="text"
                  name="name"
                  value="<%= h assignment["name"] %>"
                  maxlength="255"
                  required
                >
              </label>

              <label>
                <span>Class</span>
                <select name="course_id" required>
                  <% visible_manual_courses.sort_by { |_course_id, course| course["name"] }.each do |course_id, course| %>
                    <option
                      value="<%= h course_id %>"
                      <%= "selected" if course_id == assignment["course_id"] %>
                    >
                      <%= h course["name"] %>
                    </option>
                  <% end %>
                </select>
              </label>

              <label>
                <span>Due</span>
                <input
                  type="datetime-local"
                  name="due_at"
                  value="<%= h Time.parse(assignment["due_at"]).getlocal.strftime("%Y-%m-%dT%H:%M") %>"
                  required
                >
              </label>

              <label class="coursework-completed-field">
                <input
                  type="checkbox"
                  name="completed"
                  value="true"
                  <%= "checked" if assignment["completed"] %>
                >
                <span>Completed</span>
              </label>

              <div class="coursework-row-actions">
                <button type="submit">Save</button>
                <button
                  class="danger-button"
                  type="submit"
                  name="action"
                  value="delete_assignment"
                >
                  Remove
                </button>
              </div>
            </form>
          <% end %>
        </div>

        <% if visible_manual_courses.empty? %>
          <p class="settings-help">
            Add a class outside Canvas from <a href="/settings/classes">Classes</a> before creating assignments.
          </p>
        <% else %>
          <form class="coursework-create-form assignment-coursework-row" method="post" action="/settings/grades">
            <input type="hidden" name="action" value="create_assignment">
            <% if selected_course_id %>
              <input type="hidden" name="selected_course_id" value="<%= h selected_course_id %>">
            <% end %>

            <label class="coursework-name-field">
              <span>New assignment</span>
              <input
                type="text"
                name="name"
                maxlength="255"
                placeholder="Assignment name"
                required
              >
            </label>

            <label>
              <span>Class</span>
              <select name="course_id" required>
                <% visible_manual_courses.sort_by { |_id, course| course["name"] }.each do |id, course| %>
                  <option value="<%= h id %>"><%= h course["name"] %></option>
                <% end %>
              </select>
            </label>

            <label>
              <span>Due</span>
              <input
                type="datetime-local"
                name="due_at"
                value="<%= (Time.now + 86_400).getlocal.strftime("%Y-%m-%dT%H:%M") %>"
                required
              >
            </label>

            <button type="submit">+ Add Assignment</button>
          </form>
        <% end %>
      </section>
    <% end %>
  </main>

  <script>
    const newGrades = document.getElementById("new-custom-grades");
    const gradeTemplate = document.getElementById("new-grade-template");
    let nextGradeIndex = 1;

    document.getElementById("add-grade-row").addEventListener("click", () => {
      const html = gradeTemplate.innerHTML.replaceAll(
        "__INDEX__",
        String(nextGradeIndex)
      );

      newGrades.insertAdjacentHTML("beforeend", html);
      nextGradeIndex += 1;
      updateCategoryChoices();

      newGrades.lastElementChild.querySelector('input[type="text"]').focus();
    });

    newGrades.addEventListener("click", (event) => {
      const removeButton = event.target.closest(".remove-new-grade");
      if (!removeButton) return;

      removeButton.closest(".new-custom-grade").remove();
    });

    const categoryRows = document.getElementById("grading-categories");
    function updateCategoryChoices() {
      if (!categoryRows) return;
      const categories = [...categoryRows.querySelectorAll("[data-category-id]")].map((row) => ({
        id: row.dataset.categoryId,
        name: row.querySelector("[data-category-name]").value.trim(),
        weight: row.querySelector("[data-category-weight]").value
      })).filter((category) => category.name);
      document.querySelectorAll("[data-grade-category]").forEach((select) => {
        const selected = select.value;
        select.replaceChildren(new Option("Unassigned", ""));
        categories.forEach((category) => {
          select.add(new Option(`${category.name} (${category.weight || "0"}%)`, category.id));
        });
        select.value = categories.some((category) => category.id === selected) ? selected : "";
      });
    }
    if (categoryRows) {
      categoryRows.addEventListener("input", updateCategoryChoices);
      let nextCategoryIndex = 0;
      document.getElementById("add-grading-category").addEventListener("click", () => {
        const row = categoryRows.firstElementChild.cloneNode(true);
        const id = `new-${Date.now()}-${nextCategoryIndex++}`;
        row.dataset.categoryId = id;
        row.querySelectorAll("input").forEach((input) => {
          input.name = `grading_category_${id}_${input.hasAttribute("data-category-name") ? "name" : "weight"}`;
          input.value = "";
        });
        categoryRows.append(row);
        row.querySelector("input").focus();
      });
    }
  </script>
</body>
</html>
